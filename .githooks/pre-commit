#!/usr/bin/env bash
# ==============================================================================
# pre-commit hook — regenerates agents/ + .omp/agents/ from .claude/agents/*.md
#
# Install once: git config core.hooksPath .githooks
# ==============================================================================

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [[ -f "$REPO_ROOT/generate-agents.sh" ]]; then
  echo "[pre-commit] Generating agents/ + .omp/agents/..."
  "$REPO_ROOT/generate-agents.sh"
  git add "$REPO_ROOT/agents/" "$REPO_ROOT/.omp/agents/"
fi

