#!/usr/bin/env bash
# ==============================================================================
# pre-commit hook — regenerates agents/ + .opencode/agents/ from
# .claude/agents/*.md, then keeps the rest of .opencode/ in sync
#
# Install once: git config core.hooksPath .githooks
# ==============================================================================

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

if [[ -f "$REPO_ROOT/generate-agents.sh" ]]; then
  echo "[pre-commit] Generating agents/ + .opencode/agents/..."
  "$REPO_ROOT/generate-agents.sh"
  git add "$REPO_ROOT/agents/"
fi

if [[ -f "$REPO_ROOT/sync-opencode.sh" ]]; then
  echo "[pre-commit] Syncing .opencode/..."
  "$REPO_ROOT/sync-opencode.sh"
  # Stage only what sync-opencode.sh actually manages — not the whole
  # .opencode/ tree, which can pick up stray files other tools drop there
  # (e.g. opencode itself writing a package-lock.json at .opencode/ root).
  git add \
    "$REPO_ROOT/.opencode/AGENTS.md" \
    "$REPO_ROOT/.opencode/agents/" \
    "$REPO_ROOT/.opencode/skills/generic/" \
    "$REPO_ROOT/.opencode/skills/_index.md" \
    "$REPO_ROOT/.opencode/skills/skill-creator/" \
    "$REPO_ROOT/.opencode/skills/skill-sync/" \
    "$REPO_ROOT/.opencode/skills/feedback-loop/"
fi
